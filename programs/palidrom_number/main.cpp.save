#include <iostream>

using namespace std;

int reverseNumber(int n) {
    int reversed = 0;

    while (n != 0) {
        int lastDigit = n % 10;
        reversed = reversed * 10 + lastDigit;
        n /= 10;
    }

    return reversed;
}

int main(){
	int num, reversed;
	bool isPalidrom = false;

	cout << "Enter a number: ";
	cin >> num;

    reversed = reverseNumber(num);
    if(num == reversed){
        isPalidrom = true;
    }

	return 0;
}
