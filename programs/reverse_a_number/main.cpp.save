#include <iostream>
#include <string>
#include <algorithm>

using namespace std;

int reverseNumber(int n) {
    int reversed = 0;

    while (n != 0) {
        int lastDigit = n % 10;
        reversed = reversed * 10 + lastDigit;
        n /= 10;
    }

    return reversed;
}

int reverseNumberString(int n) {
    bool isNegative = n < 0;
    string str = to_string(abs(n));
    
    reverse(str.begin(), str.end());
    
    int result = stoi(str);
    return isNegative ? -result : result;
}

int main(){
	int num;

	cout << "Enter a number: ";
	cin >> num;

    cout << "Original number: " << num << "\n";
    cout << "Reversed number: " << reverseNumber(num) << "\n";
    

	return 0;
}
